{
  "name": "interview-prep",
  "version": "1.1.0",
  "private": true,
  "description": "Daily interview-prep tracker (HR, delivery/program management, people management, technical architecture, AI automation) with login and per-user progress, deployed on Cloudflare Workers + D1.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "dev:web": "vite dev",
    "build:web": "tsc --noEmit && vite build",
    "db:create": "wrangler d1 create interview-prep-db",
    "db:migrate:local": "wrangler d1 execute interview-prep-db --local --file=./migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute interview-prep-db --remote --file=./migrations/0001_init.sql",
    "db:migrate:local:0002": "wrangler d1 execute interview-prep-db --local --file=./migrations/0002_accounts_security_activity.sql",
    "db:migrate:remote:0002": "wrangler d1 execute interview-prep-db --remote --file=./migrations/0002_accounts_security_activity.sql",
    "db:migrate:local:0003": "wrangler d1 execute interview-prep-db --local --file=./migrations/0003_relational_content.sql",
    "db:migrate:remote:0003": "wrangler d1 execute interview-prep-db --remote --file=./migrations/0003_relational_content.sql",
    "db:seed:local": "wrangler d1 execute interview-prep-db --local --file=./migrations/seed_official_bank.sql",
    "db:seed:remote": "wrangler d1 execute interview-prep-db --remote --file=./migrations/seed_official_bank.sql",
    "db:migrate:local:0004": "wrangler d1 execute interview-prep-db --local --file=./migrations/0004_ai_usage_insights.sql",
    "db:migrate:remote:0004": "wrangler d1 execute interview-prep-db --remote --file=./migrations/0004_ai_usage_insights.sql",
    "db:migrate:local:0005": "wrangler d1 execute interview-prep-db --local --file=./migrations/0005_profile_fields.sql",
    "db:migrate:remote:0005": "wrangler d1 execute interview-prep-db --remote --file=./migrations/0005_profile_fields.sql",
    "db:migrate:local:0006": "wrangler d1 execute interview-prep-db --local --file=./migrations/0006_workers_ai_model_choice.sql",
    "db:migrate:remote:0006": "wrangler d1 execute interview-prep-db --remote --file=./migrations/0006_workers_ai_model_choice.sql",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "^4.20.0"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
